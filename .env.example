# Site URL (used for sitemap, canonical URLs, Open Graph)
NEXT_PUBLIC_SITE_URL=https://bykyndall.com

# Substack publication URL (optional override; defaults to human.md)
# NEXT_PUBLIC_SUBSTACK_URL=https://humanmd.substack.com

# Stripe. Needed for paid booking ($200/hour), the editing mini guide
# presale ($25), and buy me a matcha ($5 / $10 / custom).
# Create a free Stripe account, paste the secret key here or in Vercel env.
# You do not need Calendly. Stripe only takes its cut when someone pays.
STRIPE_SECRET_KEY=

# Optional. Booking, coffee, and the guide can charge via amount in code without these.
STRIPE_PRICE_SESSION=
STRIPE_PRICE_COFFEE=
STRIPE_PRICE_EDITING_COURSE=

# Optional referral URL overrides. Defaults live in src/lib/store.ts.
AFFILIATE_WISPR=
AFFILIATE_BENTO=
AFFILIATE_ARCADS=
