# Site URL (used for sitemap, canonical URLs, Open Graph)
NEXT_PUBLIC_SITE_URL=https://bykyndall.com

# Substack publication URL (optional override; defaults to human.md)
# NEXT_PUBLIC_SUBSTACK_URL=https://humanmd.substack.com

# Paid store on /links and /book
# 1. Create the products in Stripe.
# 2. Paste each price_ id below.
# 3. Add the same keys in Vercel env, then checkout goes live without a code change.
# Booking only shows the calendar AFTER Stripe says the session is paid.
STRIPE_SECRET_KEY=
STRIPE_PRICE_BOOKING=
STRIPE_PRICE_EDITING_GUIDE=
STRIPE_PRICE_UGC_KIT=

# Server-only. Shown on /book/schedule after payment. Example: https://cal.com/you/30min
CAL_URL=

# Optional referral URLs. Falls back to the official product pages.
AFFILIATE_WISPR=
AFFILIATE_BENTO=
