# Site URL (used for sitemap, canonical URLs, Open Graph)
NEXT_PUBLIC_SITE_URL=https://bykyndall.com

# Substack publication URL (optional override; defaults to human.md)
# NEXT_PUBLIC_SUBSTACK_URL=https://humanmd.substack.com

# Paid 1:1 sessions on /work-with-me
# One Stripe price + calendar URL per session type. Add a new session in src/lib/store.ts.
STRIPE_SECRET_KEY=
STRIPE_PRICE_CONTENT_STRATEGY=
STRIPE_PRICE_AI_INTEGRATIONS=
STRIPE_PRICE_EDITING_GUIDE=
STRIPE_PRICE_UGC_KIT=

# Server-only calendars, shown after payment. Fallback CAL_URL is used if a session is missing its own.
# Example: https://cal.com/you/content-strategy
CAL_URL=
CAL_URL_CONTENT_STRATEGY=
CAL_URL_AI_INTEGRATIONS=

# Optional referral URLs. Falls back to the official product pages.
AFFILIATE_WISPR=
AFFILIATE_BENTO=
